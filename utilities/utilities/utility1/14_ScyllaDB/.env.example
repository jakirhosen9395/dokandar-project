# Optional config for `test.sh` — copy to `.env` to point the test at ANY ScyllaDB with these values.
#   cp .env.example .env        # then fill in host + port
# `.env` is gitignored. test.sh uses this only when you DON'T pass a variant folder / set them via env.

# SCYLLA_HOST=127.0.0.1
# SCYLLA_CQL_PORT=9042

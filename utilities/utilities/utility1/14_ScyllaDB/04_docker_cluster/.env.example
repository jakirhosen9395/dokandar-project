# ScyllaDB — Docker HA cluster (3-node ring). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# ScyllaDB has no auth by default — there is no password to generate. Use replication_factor=3 for HA.

SCYLLA_IMAGE=scylladb/scylla:2026.1
SCYLLA_CLUSTER_NAME=dokandar

# Each node publishes its CQL port on the host.
SCY_CQL1=9042
SCY_CQL2=9043
SCY_CQL3=9044

# Per-node data under ${DATA_ROOT}/scylla_cluster/n{1,2,3} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

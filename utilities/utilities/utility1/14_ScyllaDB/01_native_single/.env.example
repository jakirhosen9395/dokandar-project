# ScyllaDB — native single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# ScyllaDB has no auth by default — there is no password to generate.

SCYLLA_CLUSTER_NAME=dokandar
SCYLLA_CQL_PORT=9042
# rpc_address (CQL bind). 0.0.0.0 exposes CQL off-box (SG-fenced; setup.sh sets broadcast_rpc_address
# automatically, which Scylla requires for a wildcard rpc_address); 127.0.0.1 = loopback only.
SCYLLA_RPC_ADDRESS=0.0.0.0

# Data under ${DATA_ROOT}/scylla (symlinked to /var/lib/scylla).
DATA_ROOT=/data

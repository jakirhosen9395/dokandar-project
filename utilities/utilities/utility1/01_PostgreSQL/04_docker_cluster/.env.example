# PostgreSQL 18 — Docker Compose HA cluster (1 primary + 2 streaming replicas). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines —
# Docker `env_file` does NOT strip inline comments (they would become part of the value).

# Host directory holding the per-node data (BIND MOUNTS, survive `docker compose down -v`):
#   ${DATA_ROOT}/postgresql_cluster/{primary,replica1,replica2}
DATA_ROOT=/data
POSTGRES_VERSION=18

# Superuser / password / default DB. Override per run with: setup.sh up --user NAME --db NAME
POSTGRES_USER=postgres
# LEAVE EMPTY to auto-generate a COMPLEX password (shown once, then saved here). `setup.sh up` fills it
# before `docker compose up` and enforces it on the primary via ALTER ROLE (rotation via --gen-password).
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Physical-replication role created on the primary; the replicas stream as this role.
# LEAVE REPL_PASSWORD EMPTY to auto-generate it ONCE (on first up, before the replicas clone). It is
# baked into the replicas' primary_conninfo, so it is NEVER rotated by --gen-password (that touches only
# the superuser). Avoid a single quote in it — it goes into primary_conninfo.
REPL_USER=replicator
REPL_PASSWORD=

# Cluster data dir INSIDE each container (subdir of the bind-mount target /var/lib/postgresql).
PGDATA=/var/lib/postgresql/pgdata

# Host ports. PRIMARY (RW) = POSTGRES_PORT (test.sh connects here); the two replicas (RO) below.
# Change all three if taken on this host (e.g. 5442 / 5443 / 5444).
POSTGRES_PORT=5432
PG_REPLICA1_PORT=5433
PG_REPLICA2_PORT=5434

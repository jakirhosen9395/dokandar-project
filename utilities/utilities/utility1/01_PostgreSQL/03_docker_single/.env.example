# PostgreSQL 18 — Docker Compose single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored (it may carry a real password); only this `.env.example` is committed.
# Keep comments on their OWN lines — NO inline `# ...` after a value — because Docker `env_file`
# does NOT strip inline comments (it would make the comment part of the value).

# Host directory that holds the cluster (BIND MOUNT). Survives `docker compose down -v`.
DATA_ROOT=/data
# PostgreSQL image tag (Docker Hub `postgres`)
POSTGRES_VERSION=18

# Superuser / password / default database — the official `postgres` image's standard vars.
# Override per run with: setup.sh up --user NAME --db NAME
POSTGRES_USER=postgres
# LEAVE EMPTY to auto-generate a COMPLEX password (shown once, then saved back here). `setup.sh up`
# fills it before `docker compose up`. (Direct `docker compose up` needs a non-empty value here.)
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Host port published as 0.0.0.0:<port> -> container 5432. test.sh connects here.
# Change it (e.g. 5433) if a native PostgreSQL already owns 5432 on this host.
POSTGRES_PORT=5432

# Cluster data dir INSIDE the container. Keep it UNDER /var/lib/postgresql (the bind-mount target;
# a subdir avoids bind-mount ownership issues), so it lands on the host at ${DATA_ROOT}/postgresql_docker/pgdata.
PGDATA=/var/lib/postgresql/pgdata

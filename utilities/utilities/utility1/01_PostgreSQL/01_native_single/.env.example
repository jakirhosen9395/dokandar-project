# PostgreSQL 18 — native single-node (no Docker). Copy to `.env` and edit; `setup.sh` sources it.
#   cp .env.example .env
# `.env` is gitignored (it holds the real password); only this `.env.example` is committed.
# Keep comments on their OWN lines (no inline `# ...` after a value).

# data lives at ${DATA_ROOT}/postgresql (symlinked, preserved on uninstall)
DATA_ROOT=/data
# address shown in the connection summary
HOST_IP=127.0.0.1

# superuser/role name. Override per run with: setup.sh install --user NAME
POSTGRES_USER=postgres
# LEAVE EMPTY to auto-generate a COMPLEX password on install (shown once, then saved back here).
# Or set a fixed one, or pass setup.sh install --password '...' / --gen-password.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# 'localhost' = loopback only; set '*' (or HOST_IP) for remote TCP.
POSTGRES_LISTEN_ADDRESSES=localhost
# application database to create (empty => none). Override per run with: setup.sh install --db NAME
POSTGRES_DB=

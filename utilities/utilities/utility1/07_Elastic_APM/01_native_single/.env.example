# Elastic APM 9.4 — native single-node (Elasticsearch + APM Server + Kibana). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# `setup.sh install` auto-generates the ES password, the kibana_system password, and the APM secret token
# (shown once, saved here). `--gen-password` rotates the ES + kibana_system passwords.

ELASTIC_VERSION=9.4

ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
APM_SECRET_TOKEN=

# JVM heap for Elasticsearch (Kibana also needs RAM).
ES_JAVA_HEAP=512m

# Ports: Elasticsearch / APM ingest / Kibana UI.
ES_HTTP_PORT=9200
APM_PORT=8200
KIBANA_PORT=5601

# Data lives under ${DATA_ROOT}/apm_stack (ES data in es/, symlinked from /var/lib/elasticsearch).
DATA_ROOT=/data

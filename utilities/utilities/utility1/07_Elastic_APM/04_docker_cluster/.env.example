# Elastic APM 9.4 — Docker Compose HA (Elasticsearch + 2 APM Server replicas + Kibana). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# `setup.sh up` auto-generates the ES password, kibana_system password, and APM secret token (shown once,
# saved here). `--gen-password` rotates the ES + kibana_system passwords.

ELASTIC_VERSION=9.4.2

ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
APM_SECRET_TOKEN=

ES_JAVA_HEAP=512m

# Ports: Elasticsearch / APM replica 1 / APM replica 2 / Kibana UI.
ES_HTTP_PORT=9200
APM_PORT=8200
APM_PORT2=8201
KIBANA_PORT=5601

# Host directory holding the data (BIND MOUNT — survives `docker compose down -v`).
DATA_ROOT=/data

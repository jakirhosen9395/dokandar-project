# Optional config for `test.sh` — copy to `.env` to point the APM test at ANY stack with these values.
#   cp .env.example .env        # then fill in the host + secrets
# `.env` is gitignored. test.sh uses this only when you DON'T pass a variant folder / set them via env.
# The test sends an APM event to APM_HOST:APM_PORT and verifies it in Elasticsearch (needs the ES password).

# APM_HOST=127.0.0.1
# APM_PORT=8200
# ES_HTTP_PORT=9200
# KIBANA_PORT=5601
# APM_SECRET_TOKEN=youragentsecrettoken
# ELASTIC_PASSWORD=yourespassword

# Elastic APM stack — Docker Compose single-node (Elasticsearch + Kibana + apm-server). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# `setup.sh up` auto-generates the 4 secrets below (shown ONCE on the console + saved here).
# `setup.sh up --gen-secrets` rotates them.

ELASTIC_VERSION=9.4.2

# Elasticsearch superuser password (user: elastic). Leave EMPTY → setup.sh generates a 40-char value.
ELASTIC_PASSWORD=
# kibana_system service-user password — Kibana logs in as this user. EMPTY → generated.
KIBANA_PASSWORD=
# Kibana saved-objects encryption key — MUST be 32 chars. EMPTY → setup.sh generates exactly 32.
KIBANA_ENCRYPTION_KEY=
# APM agent secret token (agents send `Authorization: Bearer <token>`). EMPTY → generated.
APM_SECRET_TOKEN=

# JVM heap for Elasticsearch (keep small; Kibana also needs RAM).
ES_JAVA_HEAP=1g

# Published host ports: Elasticsearch / APM ingest / Kibana UI.
ES_HTTP_PORT=9200
APM_PORT=8200
KIBANA_PORT=5601

# Host directory holding the data (BIND MOUNT — survives `docker compose down -v`).
DATA_ROOT=/data

# Optional connection config for `test.sh` — copy to `.env` to point the test at ANY Redis with one value.
#   cp .env.example .env        # then uncomment ONE option below
# `.env` is gitignored. test.sh uses this only when you DON'T pass a TARGET arg or REDIS_URL.
# (Priority: a URL arg / REDIS_URL > THIS .env > a per-variant .env > parts/defaults 127.0.0.1:6379.)

# Option A — a single redis URL:
# REDIS_URL=redis://default:yourpassword@127.0.0.1:6379

# Option B — individual parts:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=yourpassword

# Image tag used for docker-mode (when no host redis-cli).
# REDIS_VERSION=8

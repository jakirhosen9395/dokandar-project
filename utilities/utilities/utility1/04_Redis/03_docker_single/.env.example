# Redis 8 — Docker Compose single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave REDIS_PASSWORD EMPTY to auto-generate a COMPLEX password (`setup.sh up` fills it BEFORE
# `docker compose up`, shows it once, saves it here). A no-flag re-run REUSES it; `--gen-password` rotates.

REDIS_VERSION=8

# requirepass value; auto-generated if empty.
REDIS_PASSWORD=

# Host port published (container listens on 6379). Change if a native redis already holds 6379.
REDIS_PORT=6379

# Eviction cap (allkeys-lru policy).
REDIS_MAXMEMORY=256mb

# Host directory holding the data (BIND MOUNT, AOF — survives `docker compose down -v`).
DATA_ROOT=/data

# Redis 8 — native single-node (no Docker). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave REDIS_PASSWORD EMPTY to auto-generate a COMPLEX 24-char password (shown once at the end of
# `setup.sh install`, then saved here). A no-flag re-run REUSES it; `--gen-password` rotates it.
# Auth is always ON (requirepass; the ACL `default` user).

# Network. 0.0.0.0 lets a remote client reach it (requirepass is required); 127.0.0.1 restricts to loopback.
REDIS_PORT=6379
REDIS_BIND=0.0.0.0

# requirepass value; auto-generated if empty.
REDIS_PASSWORD=

# Eviction cap (single-box). allkeys-lru policy is set by setup.sh.
REDIS_MAXMEMORY=256mb

# Data lives under ${DATA_ROOT}/redis (AOF persistence; symlinked from /var/lib/redis).
DATA_ROOT=/data

# Redis 8 — Docker Compose HA cluster (Redis Cluster: 3 primaries + 3 replicas). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave REDIS_PASSWORD EMPTY to auto-generate a COMPLEX password (`setup.sh up` fills it before forming
# the cluster, shows it once, saves it here). A no-flag re-run REUSES it; `--gen-password` rotates it.

REDIS_VERSION=8

# requirepass + masterauth value; auto-generated if empty.
REDIS_PASSWORD=

# IP the cluster nodes ANNOUNCE to clients (for MOVED redirects). setup.sh sets it to the host's first IP
# so the cluster is reachable both locally and cross-host. Override to a specific reachable IP if needed.
CLUSTER_ANNOUNCE_IP=

# 6 nodes use host ports 7001-7006 (data) + 17001-17006 (bus). Per-node data under
# ${DATA_ROOT}/redis_cluster/{n1..n6} (BIND MOUNTS, AOF — survive `docker compose down -v`).
DATA_ROOT=/data

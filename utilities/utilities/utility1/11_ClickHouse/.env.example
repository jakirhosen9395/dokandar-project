# Optional config for `test.sh` — copy to `.env` to point the test at ANY ClickHouse with these values.
#   cp .env.example .env        # then fill in host + creds
# `.env` is gitignored. test.sh uses this only when you DON'T pass a variant folder / set them via env.

# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your-password

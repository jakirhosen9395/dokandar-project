# ClickHouse — Docker HA cluster (1 shard x 3 replicas + embedded 3-node Keeper). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates CLICKHOUSE_PASSWORD if empty, writes it back here, and RENDERS the per-node
# config (keeper server_id + replica macro + remote_servers + zookeeper) under ${DATA_ROOT}/clickhouse_cluster.

# 26.3 LTS image (CalVer).
CH_IMAGE=clickhouse/clickhouse-server:26.3

CLICKHOUSE_USER=default
# Leave EMPTY → setup.sh generates a 24-char password and writes it here (identical on all 3 nodes).
CLICKHOUSE_PASSWORD=

# Each node publishes its HTTP port on the host (ch1 also publishes the native TCP port).
CH_HTTP1=8123
CH_HTTP2=8124
CH_HTTP3=8125
CH_TCP1=9000
CH_CLUSTER=dokandar_1S_3R

# Per-node config + data under ${DATA_ROOT}/clickhouse_cluster/n{1,2,3} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

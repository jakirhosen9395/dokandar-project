# ClickHouse — native single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates CLICKHOUSE_PASSWORD if it's empty, and saves it back here.

# The `default` SQL user. Override at install with --user U.
CLICKHOUSE_USER=default
# Password for that user. Leave EMPTY → setup.sh generates a 24-char password and writes it here.
CLICKHOUSE_PASSWORD=

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
# Bind address. 0.0.0.0 exposes the HTTP /play console + native port off-box (SG-fenced); use 127.0.0.1 to keep loopback-only.
CLICKHOUSE_LISTEN_HOST=0.0.0.0

# Data under ${DATA_ROOT}/clickhouse (symlinked from /var/lib/clickhouse).
DATA_ROOT=/data

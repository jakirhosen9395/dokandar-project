# ClickHouse — Docker single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates CLICKHOUSE_PASSWORD if empty, and writes it back here.

# 26.3 LTS image (CalVer). Override if you need a specific patch tag.
CH_IMAGE=clickhouse/clickhouse-server:26.3

CLICKHOUSE_USER=default
# Leave EMPTY → setup.sh generates a 24-char password and writes it here.
CLICKHOUSE_PASSWORD=

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# Host bind mount under ${DATA_ROOT}/clickhouse_docker (survives `down -v`).
DATA_ROOT=/data

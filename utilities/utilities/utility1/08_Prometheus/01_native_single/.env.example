# Prometheus 3.12 — native single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Prometheus has NO built-in auth. The web UI + API bind PROMETHEUS_LISTEN — keep it firewalled to trusted
# clients (these tests run over an AWS SG that only admits the test box; production: behind a reverse proxy).

PROM_VERSION=3.12.0

# Listen address + port (the built-in web UI + HTTP API). 0.0.0.0 for remote clients; 127.0.0.1 loopback.
PROMETHEUS_LISTEN=0.0.0.0
PROMETHEUS_PORT=9090

# Local TSDB retention.
PROMETHEUS_RETENTION=15d

# Data lives under ${DATA_ROOT}/prometheus (symlinked from /var/lib/prometheus).
DATA_ROOT=/data

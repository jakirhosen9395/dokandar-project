# Prometheus 3.12 — Docker Compose HA (2 replicas + Thanos Querier). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
# (No auth; the scrape configs are the committed ./prometheus-a.yml / ./prometheus-b.yml.)

PROM_VERSION=3.12.0
THANOS_VERSION=0.41.0

# Host ports: replica A / replica B (raw Prometheus) / Thanos Querier (the deduplicated query API + UI).
PROM_A_PORT=9090
PROM_B_PORT=9092
THANOS_PORT=10902
PROMETHEUS_RETENTION=15d

# Per-replica TSDB under ${DATA_ROOT}/prometheus_cluster/{a,b} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

# Optional config for `test.sh` — copy to `.env` to point the test at ANY Prometheus / Thanos Querier.
#   cp .env.example .env        # then uncomment ONE option below
# `.env` is gitignored. test.sh uses this only when you DON'T pass a TARGET arg or PROM_URL.
# (Priority: a URL arg / PROM_URL > THIS .env > a per-variant .env > parts/defaults 127.0.0.1:9090.)

# Option A — a single base URL:
# PROM_URL=http://127.0.0.1:9090

# Option B — host + port:
# PROM_HOST=127.0.0.1
# PROMETHEUS_PORT=9090

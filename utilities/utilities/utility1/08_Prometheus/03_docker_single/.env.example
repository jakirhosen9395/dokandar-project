# Prometheus 3.12 — Docker Compose single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
# (Prometheus has no auth; the scrape config is the committed ./prometheus.yml.)

PROM_VERSION=3.12.0

# Host port published (container listens on 9090). Change if a native Prometheus already holds 9090.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Host directory holding the TSDB data (BIND MOUNT — survives `docker compose down -v`).
DATA_ROOT=/data

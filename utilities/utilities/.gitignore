# Local secret env files — generated by each tool's setup.sh on `up`/`install`.
# They hold real passwords/tokens/keys (chmod 600). NEVER commit them.
# Only the committed `.env.example` templates are tracked.
.env
**/.env

# Keep the templates tracked even if a broader rule ever matches them.
!.env.example
!**/.env.example

# Docker convenience-script artifact from the README quick start.
get-docker.sh

# Common local noise.
*.log
*.tmp
.DS_Store

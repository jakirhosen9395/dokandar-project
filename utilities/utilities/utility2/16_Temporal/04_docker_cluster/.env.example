# Temporal — Docker HA cluster (PostgreSQL + 3 servers + UI). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates PG_PASSWORD if empty, and writes it back here.

TEMPORAL_IMAGE=temporalio/auto-setup:latest
TEMPORAL_UI_IMAGE=temporalio/ui:latest
POSTGRES_IMAGE=postgres:16

# PostgreSQL password for the temporal user (the durable store). Leave EMPTY → setup.sh generates one.
PG_PASSWORD=

# Each temporal node publishes its frontend gRPC port; the UI publishes its HTTP port.
T_GRPC1=7233
T_GRPC2=7234
T_GRPC3=7235
T_UI=8233

# PostgreSQL data under ${DATA_ROOT}/temporal_cluster/pg (BIND MOUNT — survives `down -v`).
DATA_ROOT=/data

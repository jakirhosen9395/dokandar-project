# Temporal — native single-node (dev server). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# The dev server has no auth — there is nothing secret to generate.

TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233
# Bind address. 0.0.0.0 exposes the frontend + UI off-box (SG-fenced); 127.0.0.1 = loopback only.
TEMPORAL_BIND=0.0.0.0
TEMPORAL_NAMESPACE=default

# SQLite persistence under ${DATA_ROOT}/temporal.
DATA_ROOT=/data

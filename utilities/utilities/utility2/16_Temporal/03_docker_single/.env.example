# Temporal — Docker single-node (dev server). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# The dev server has no auth — there is nothing secret to generate.

# The admin-tools image bundles the temporal CLI (which runs the embedded dev server).
TEMPORAL_ADMINTOOLS_IMAGE=temporalio/admin-tools:latest

TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233

# Host bind mount under ${DATA_ROOT}/temporal_docker (SQLite store — survives `down -v`).
DATA_ROOT=/data

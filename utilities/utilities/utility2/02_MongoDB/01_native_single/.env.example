# MongoDB 7.0 — native single-node (no Docker). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave MONGO_ROOT_PASSWORD EMPTY to auto-generate a COMPLEX 24-char password (shown once at the end of
# `setup.sh install`, then saved back here). A no-flag re-run REUSES it; `--gen-password` rotates it.
# Override the root user / initial db with `setup.sh install --user NAME --db NAME` (or set them here).

# Version + apt repo codename. MongoDB 8.x crashloops on Ubuntu/kernel 7.0 (SERVER-121912) — 7.0 is the
# Ubuntu-host pin. MongoDB publishes 7.0 for jammy/focal, NOT noble/resolute (those 404).
MONGO_VERSION=7.0
MONGO_REPO_CODENAME=jammy

# Root (admin) credentials. authSource is always `admin`.
MONGO_ROOT_USER=dokandar
MONGO_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=

# Network. bindIp 0.0.0.0 lets a remote client (e.g. the 15.x test box) reach it — auth is required.
# Set to 127.0.0.1 to restrict to loopback.
MONGO_PORT=27017
MONGO_BIND_IP=0.0.0.0

# Data lives under ${DATA_ROOT}/mongodb (symlinked from /var/lib/mongodb). Non-destructive to siblings.
DATA_ROOT=/data

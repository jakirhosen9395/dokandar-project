# MongoDB — Docker SHARDED CLUSTER (mongos + config-RS + 2 shards). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates the keyFile + MONGO_ROOT_PASSWORD if empty, and writes the password back here.

MONGO_VERSION=7.0

# Cluster root user (created on the config-RS via the mongos localhost exception). Leave the password EMPTY
# → setup.sh generates a 24-char one and writes it here.
MONGO_ROOT_USER=dokandar
MONGO_ROOT_PASSWORD=

# Host port for mongos (the single client entry point).
MONGOS_PORT=27017
# Database whose `items` collection gets sharded (hashed _id) for the acceptance.
SHARD_DB=dokandar

# keyFile (internal auth, shared by every component). Generated by setup.sh; mode 400, uid 999.
KEYFILE_HOST_PATH=/data/mongodb_sharded/keyfile

# Per-component data under ${DATA_ROOT}/mongodb_sharded/{cfg1,s1a,s1b,s2a,s2b} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

# MongoDB 7.0 — Docker Compose single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines —
# Docker `environment:`/`--env-file` does NOT strip inline comments (they'd become part of the value).

# Leave MONGO_ROOT_PASSWORD EMPTY to auto-generate a COMPLEX 24-char password (`setup.sh up` fills it
# BEFORE `docker compose up`, shows it once, saves it here). A no-flag re-run REUSES it; `--gen-password`
# rotates it (via mongosh on the running container). Override user/db with `setup.sh up --user U --db D`.

# Image version. 8.x crashloops on Ubuntu/kernel 7.0 (SERVER-121912) — pin 7.0 on such hosts.
MONGO_VERSION=7.0

# Root (admin) credentials + optional initial database. authSource is always `admin`.
MONGO_ROOT_USER=dokandar
MONGO_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=

# Host port published to 127.0.0.1/0.0.0.0 (container always listens on 27017). Change if taken
# (e.g. 27018 if a native mongod already holds 27017 on this host).
MONGO_PORT=27017

# Host directory holding the data (BIND MOUNTS — survive `docker compose down -v`):
#   ${DATA_ROOT}/mongodb_docker/{db,configdb}
DATA_ROOT=/data

# OpenBao 2.x — Docker Compose single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# `setup.sh up` INITIALISES the server and writes the generated ROOT TOKEN + UNSEAL KEY back here
# (BAO_ROOT_TOKEN / BAO_UNSEAL_KEY) — treat them as secrets. The server config is the committed
# ./openbao.hcl (file storage). 1 key / threshold 1 is a DEV convenience.

BAO_VERSION=2.5.4

# Host port published (container listens on 8200). Change if a native OpenBao already holds 8200 (e.g. 8201).
BAO_API_PORT=8200

# Written by setup.sh after `operator init` — DO NOT pre-fill.
BAO_ROOT_TOKEN=
BAO_UNSEAL_KEY=

# Host directory holding the file-storage data + seal (BIND MOUNT — survives `docker compose down -v`).
DATA_ROOT=/data

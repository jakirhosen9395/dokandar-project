# Optional config for `test.sh` — copy to `.env` to point the test at ANY OpenBao with these values.
#   cp .env.example .env        # then fill in host + token
# `.env` is gitignored. test.sh uses this only when you DON'T pass a variant folder / set them via env.

# BAO_HOST=127.0.0.1
# BAO_API_PORT=8200
# BAO_TOKEN=your-root-or-app-token   # (or BAO_ROOT_TOKEN from a variant's .env)

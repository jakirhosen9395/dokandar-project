# OpenBao 2.x — Docker Compose HA cluster (3-node integrated Raft). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# `setup.sh up` initialises node 1 and writes the generated ROOT TOKEN + UNSEAL KEY back here — treat them
# as secrets. ONE unseal key unseals ALL 3 nodes (1 key / threshold 1 is a DEV convenience).
# Per-node configs are the committed ./bao-1.hcl / ./bao-2.hcl / ./bao-3.hcl.

BAO_VERSION=2.5.4

# Host API ports for the 3 nodes (each container listens on 8200; Raft cluster traffic is internal :8201).
BAO_PORT1=8200
BAO_PORT2=8202
BAO_PORT3=8203

# Written by setup.sh after `operator init` — DO NOT pre-fill.
BAO_ROOT_TOKEN=
BAO_UNSEAL_KEY=

# Per-node Raft data under ${DATA_ROOT}/openbao_cluster/{n1,n2,n3} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

# OpenBao 2.x — native single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# OpenBao boots SEALED + uninitialised. `setup.sh install` INITIALISES it and writes the generated
# ROOT TOKEN + UNSEAL KEY back here (BAO_ROOT_TOKEN / BAO_UNSEAL_KEY) — treat them as secrets.
# (1 key / threshold 1 is a DEV convenience; production uses 5-of-3 Shamir and a proper seal.)

BAO_VERSION=2.5.4

# Listener (TLS disabled for dev). 0.0.0.0 lets a remote client reach it; 127.0.0.1 for loopback.
BAO_LISTEN=0.0.0.0
BAO_API_PORT=8200

# Written by setup.sh after `operator init` — DO NOT pre-fill.
BAO_ROOT_TOKEN=
BAO_UNSEAL_KEY=

# Data lives under ${DATA_ROOT}/openbao (file storage). `purge` deletes secrets + the seal (unrecoverable).
DATA_ROOT=/data

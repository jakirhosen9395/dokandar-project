# Neo4j — native single-node (Community). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates NEO4J_PASSWORD if it's empty, and saves it back here.

NEO4J_USER=neo4j
# Password for the neo4j user (Neo4j requires >= 8 chars). Leave EMPTY → setup.sh generates a 24-char one.
NEO4J_PASSWORD=

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Bind address. 0.0.0.0 exposes the Browser UI + Bolt off-box (SG-fenced); 127.0.0.1 = loopback only.
NEO4J_LISTEN_ADDRESS=0.0.0.0

# Data under ${DATA_ROOT}/neo4j (symlinked from /var/lib/neo4j/data).
DATA_ROOT=/data

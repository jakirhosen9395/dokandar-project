# Optional config for `test.sh` — copy to `.env` to point the test at ANY Neo4j with these values.
#   cp .env.example .env        # then fill in host + creds
# `.env` is gitignored. test.sh uses this only when you DON'T pass a variant folder / set them via env.

# NEO4J_HOST=127.0.0.1
# NEO4J_HTTP_PORT=7474
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

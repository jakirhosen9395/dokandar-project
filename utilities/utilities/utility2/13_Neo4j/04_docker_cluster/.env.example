# Neo4j — Docker HA cluster (3 PRIMARY servers, Enterprise EVAL licence). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates NEO4J_PASSWORD if empty (identical on all 3 primaries) and writes it back here.
#
# NOTE: this uses Neo4j ENTERPRISE under the EVALUATION licence (NEO4J_ACCEPT_LICENSE_AGREEMENT=eval) —
# dev/test only. Neo4j Community is single-node by design; Causal/autonomous clustering is Enterprise.

NEO4J_IMAGE=neo4j:2026.05.0-enterprise

NEO4J_USER=neo4j
# Password (>= 8 chars). Leave EMPTY → setup.sh generates a 24-char one (same on all nodes).
NEO4J_PASSWORD=

# Each primary publishes its HTTP + Bolt ports on the host.
N_HTTP1=7474
N_HTTP2=7475
N_HTTP3=7476
N_BOLT1=7687
N_BOLT2=7688
N_BOLT3=7689

# Per-node data under ${DATA_ROOT}/neo4j_cluster/n{1,2,3} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

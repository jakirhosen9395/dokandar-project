# Neo4j — Docker single-node (Community). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates NEO4J_PASSWORD if empty, and writes it back here.

NEO4J_IMAGE=neo4j:2026.05.0

NEO4J_USER=neo4j
# Password for the neo4j user (>= 8 chars). Leave EMPTY → setup.sh generates a 24-char one.
NEO4J_PASSWORD=

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Host bind mount under ${DATA_ROOT}/neo4j_docker (survives `down -v`).
DATA_ROOT=/data

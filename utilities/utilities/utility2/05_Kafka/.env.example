# Optional connection config for `test.sh` — copy to `.env` to point the test at ANY Kafka with one value.
#   cp .env.example .env        # then uncomment ONE option below
# `.env` is gitignored. test.sh uses this only when you DON'T pass a TARGET arg or KAFKA_BOOTSTRAP.
# (Priority: a host:port arg / KAFKA_BOOTSTRAP > THIS .env > a per-variant .env > defaults 127.0.0.1:9092.)

# Option A — a single bootstrap server:
# KAFKA_BOOTSTRAP=127.0.0.1:9092

# Option B — host + port (docker variants publish KAFKA_EXTERNAL_PORT; native uses KAFKA_BROKER_PORT):
# KAFKA_ADVERTISED_HOST=127.0.0.1
# KAFKA_BROKER_PORT=9092

# Image tag used for docker-mode (when the host has no /opt/kafka/bin tools).
# KAFKA_VERSION=4.3.0

# Apache Kafka 4.3 — native single-node (KRaft, no ZooKeeper). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Kafka runs PLAINTEXT (the platform's documented dev posture; production uses SASL_SSL). The broker is
# reachable from remote clients via advertised.listeners — set KAFKA_ADVERTISED_HOST to a REACHABLE IP
# (left empty => setup.sh auto-detects the host's first IP, which works for same-VPC cross-host tests).

KAFKA_VERSION=4.3.0
KAFKA_NODE_ID=1
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093

# Address the broker advertises to clients. Empty => host's first IP (hostname -I). Set to 127.0.0.1 for
# loopback-only, or a specific IP/DNS for remote clients.
KAFKA_ADVERTISED_HOST=

# KRaft cluster id (auto-generated on first install, saved back here).
KAFKA_CLUSTER_ID=

DATA_ROOT=/data

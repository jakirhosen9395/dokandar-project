# Apache Kafka 4.3 — Docker Compose HA cluster (KRaft: 3 broker+controller nodes). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# PLAINTEXT (dev). `setup.sh up` auto-generates the shared cluster id and sets KAFKA_ADVERTISED_HOST to
# the host's first IP so the 3 nodes advertise a reachable address (local AND cross-host).

KAFKA_VERSION=4.3.0

# Address the 3 nodes advertise to clients (empty => host's first IP, set by setup.sh). Data ports are
# 9092/9094/9096, controller ports 9093/9095/9097 (host networking — change in compose if taken).
KAFKA_ADVERTISED_HOST=

# Shared KRaft cluster id (auto-generated by setup.sh on first up).
KAFKA_CLUSTER_ID=

# Per-node data under ${DATA_ROOT}/kafka_cluster/{n1,n2,n3} (BIND MOUNTS — survive `docker compose down -v`).
DATA_ROOT=/data

# Host port for the Provectus kafka-ui (host-networked; sees all 3 brokers).
KAFKA_UI_PORT=8080
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2

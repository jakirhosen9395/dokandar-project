# Apache Kafka — Docker single-node (KRaft) + Provectus kafka-ui. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh generates KAFKA_CLUSTER_ID and sets KAFKA_EXTERNAL_HOST (this host's IP) on first `up`.

KAFKA_VERSION=4.3.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2

# Host advertised to clients OUTSIDE Docker. EMPTY → setup.sh fills it with this host's private IP/DNS.
# Local dev only: set to localhost.
KAFKA_EXTERNAL_HOST=
# KRaft cluster id (22-char base64url). EMPTY → setup.sh generates one (kafka-storage random-uuid).
# Don't change it once the broker has data — KRaft binds the log dir to the id.
KAFKA_CLUSTER_ID=

# Host ports: the external bootstrap (PLAINTEXT_HOST) and the kafka-ui.
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8080

# Host bind mount under ${DATA_ROOT}/kafka_docker (survives `down -v`).
DATA_ROOT=/data

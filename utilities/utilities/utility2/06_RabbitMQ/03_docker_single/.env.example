# RabbitMQ 4.x — Docker Compose single-node (with Management UI). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave RABBITMQ_DEFAULT_PASS EMPTY to auto-generate a COMPLEX password (`setup.sh up` fills it BEFORE
# `docker compose up`, shows it once, saves it here). A no-flag re-run REUSES it; `--gen-password` rotates.

# Management image tag (the `-management` variant ships the web UI). README pins 4.3; 4-management is 4.x.
RABBITMQ_IMAGE_TAG=4-management

RABBITMQ_DEFAULT_USER=dokandar
RABBITMQ_DEFAULT_PASS=

# Host ports published (container listens on 5672 AMQP / 15672 management). Change if a native RabbitMQ
# already holds them (e.g. 5673 / 15673).
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Host directory holding the data (BIND MOUNT — survives `docker compose down -v`).
DATA_ROOT=/data

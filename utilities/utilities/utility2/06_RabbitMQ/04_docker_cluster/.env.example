# RabbitMQ 4.x — Docker Compose HA cluster (3 nodes, quorum queues). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave RABBITMQ_DEFAULT_PASS EMPTY to auto-generate a COMPLEX password (`setup.sh up` fills it + the
# shared Erlang cookie before forming the cluster, shows the password once, saves it). `--gen-password`
# rotates the admin password.

RABBITMQ_IMAGE_TAG=4-management
RABBITMQ_DEFAULT_USER=dokandar
RABBITMQ_DEFAULT_PASS=

# Shared Erlang cookie that lets the 3 nodes authenticate to each other (auto-generated by setup.sh).
RABBITMQ_ERLANG_COOKIE=

# Node 1's published AMQP + Management ports (clients connect here; the cluster is transparent).
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Per-node data under ${DATA_ROOT}/rabbitmq_cluster/{n1,n2,n3} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

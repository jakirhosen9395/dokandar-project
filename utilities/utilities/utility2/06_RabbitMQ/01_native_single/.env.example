# RabbitMQ 4.x — native single-node (no Docker). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave RABBITMQ_DEFAULT_PASS EMPTY to auto-generate a COMPLEX password (shown once at the end of
# `setup.sh install`, then saved here). A no-flag re-run REUSES it; `--gen-password` rotates it.
# An admin user is created (and the stock `guest` user is deleted). The Management UI is on :15672.

RABBITMQ_DEFAULT_USER=dokandar
RABBITMQ_DEFAULT_PASS=

# AMQP client port + Management UI/HTTP-API port. The AMQP listener binds RABBITMQ_NODE_IP (0.0.0.0 for
# remote clients; auth required), the Management API binds 0.0.0.0.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_NODE_IP=0.0.0.0

# Data lives under ${DATA_ROOT}/rabbitmq (symlinked from /var/lib/rabbitmq).
DATA_ROOT=/data

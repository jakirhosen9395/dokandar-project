# NATS JetStream — native single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates NATS_AUTH_TOKEN if it's empty, and saves it back here.

# Single auth token (clients connect as nats://<token>@host:4222). Leave EMPTY → setup.sh generates one.
NATS_AUTH_TOKEN=

NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
# Client/monitor bind. 0.0.0.0 exposes them off-box (SG-fenced + token); 127.0.0.1 = loopback only.
NATS_HOST=0.0.0.0

# JetStream store under ${DATA_ROOT}/nats/jetstream.
DATA_ROOT=/data

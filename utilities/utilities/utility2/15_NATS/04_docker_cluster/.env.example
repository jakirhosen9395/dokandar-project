# NATS JetStream — Docker HA cluster (3-node mesh). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates NATS_AUTH_TOKEN if empty (identical on all 3 nodes) and writes it back here.

NATS_IMAGE=nats:2.14
NATS_CLUSTER_NAME=dokandar

# Single auth token (clients connect as nats://<token>@host:port). Leave EMPTY → setup.sh generates one.
NATS_AUTH_TOKEN=

# Each node publishes its client + monitoring ports on the host (route mesh 6222 is internal).
N_CLIENT1=4222
N_CLIENT2=4223
N_CLIENT3=4224
N_MON1=8222
N_MON2=8223
N_MON3=8224

# Per-node JetStream store under ${DATA_ROOT}/nats_cluster/n{1,2,3} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

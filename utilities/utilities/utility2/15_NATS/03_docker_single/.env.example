# NATS JetStream — Docker single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates NATS_AUTH_TOKEN if empty, and writes it back here.

NATS_IMAGE=nats:2.14

# Single auth token (clients connect as nats://<token>@host:4222). Leave EMPTY → setup.sh generates one.
NATS_AUTH_TOKEN=

NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# Host bind mount under ${DATA_ROOT}/nats_docker (JetStream store — survives `down -v`).
DATA_ROOT=/data

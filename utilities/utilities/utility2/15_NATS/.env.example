# Optional config for `test.sh` — copy to `.env` to point the test at ANY NATS with these values.
#   cp .env.example .env        # then fill in host + token
# `.env` is gitignored. test.sh uses this only when you DON'T pass a variant folder / set them via env.

# NATS_HOST=127.0.0.1
# NATS_CLIENT_PORT=4222
# NATS_AUTH_TOKEN=your-token

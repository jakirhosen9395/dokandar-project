# RustFS — native single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates the access/secret keys if empty, and saves them back here.

RUSTFS_VERSION=1.0.0-beta.8

# S3 access key (20 hex) + secret key (40 hex). Leave EMPTY → setup.sh generates AWS-shape keys.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# Bind address. 0.0.0.0 exposes S3 + console off-box (SG-fenced + keys); 127.0.0.1 = loopback only.
RUSTFS_LISTEN=0.0.0.0

# Data under ${DATA_ROOT}/rustfs.
DATA_ROOT=/data

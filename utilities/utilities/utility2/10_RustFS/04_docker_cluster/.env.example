# RustFS — Docker HA cluster (4-node distributed erasure set). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates the access/secret keys if empty (identical on all 4 nodes) and writes them back.

RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.8

# S3 access (20 hex) + secret (40 hex) keys. Leave EMPTY → setup.sh generates AWS-shape keys.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# node1 publishes the S3 API + console; node2 publishes its S3 API (for the read-there proof).
RFS_API1=9000
RFS_CONSOLE1=9001
RFS_API2=9002

# Per-node data under ${DATA_ROOT}/rustfs_cluster/n{1,2,3,4} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

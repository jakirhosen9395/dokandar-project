# RustFS — Docker single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates the access/secret keys if empty, and writes them back here.

# RustFS image (ref pinned 1.0.0-beta.4; this train moves fast — bump deliberately).
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.8

# S3 access key (20 hex) + secret key (40 hex). Leave EMPTY → setup.sh generates AWS-shape keys.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# S3 API host port. Default 9002 so RustFS can co-exist on the SAME host as ClickHouse's native TCP
# (9000). Console stays 9001. Use 9000 if run alone.
RUSTFS_API_PORT=9002
RUSTFS_CONSOLE_PORT=9001
# Bind address. 0.0.0.0 exposes S3 + console off-box (SG-fenced + keys); 127.0.0.1 = loopback only.
BIND_HOST=0.0.0.0

# Browser CORS allow-lists (tighten for production).
RUSTFS_CORS_ALLOWED_ORIGINS=*
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*

# Host bind mounts under ${DATA_ROOT}/rustfs_docker/{data,logs} (survive `down -v`).
DATA_ROOT=/data

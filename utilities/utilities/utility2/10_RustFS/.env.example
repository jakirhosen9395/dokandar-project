# Optional config for `test.sh` — copy to `.env` to point the test at ANY RustFS with these values.
#   cp .env.example .env        # then fill in host + keys (or paste them from setup.sh's output)
# `.env` is gitignored. test.sh uses this only when you DON'T pass a variant folder / set them via env.

# RUSTFS_HOST=127.0.0.1
# RUSTFS_API_PORT=9000
# RUSTFS_ACCESS_KEY=your-access-key
# RUSTFS_SECRET_KEY=your-secret-key

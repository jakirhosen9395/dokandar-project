# Elasticsearch 9.4 — Docker Compose single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave ELASTIC_PASSWORD EMPTY to auto-generate a COMPLEX 24-char password (`setup.sh up` fills it BEFORE
# `docker compose up`, shows it once, saves it here). A no-flag re-run REUSES it; `--gen-password` rotates.

# Full image tag (the elasticsearch image needs a specific patch version, e.g. 9.4.2).
ES_IMAGE_TAG=9.4.2

# Built-in superuser `elastic`; auto-generated if empty.
ELASTIC_PASSWORD=

ES_CLUSTER_NAME=dokandar
# JVM heap (-Xms/-Xmx); keep small on shared boxes.
ES_JAVA_HEAP=512m

# Host port published (container listens on 9200). Default 9201 so this Elasticsearch can co-exist on the
# SAME host as Server A's Elastic APM (whose Elasticsearch already binds 9200). Use 9200 if run alone.
ES_HTTP_PORT=9201

# Host directory holding the data (BIND MOUNT — survives `docker compose down -v`).
DATA_ROOT=/data

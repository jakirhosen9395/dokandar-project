# Elasticsearch 9.4 — native single-node (no Docker). Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave ELASTIC_PASSWORD EMPTY to auto-generate a COMPLEX 24-char password (shown once at the end of
# `setup.sh install`, then saved here). A no-flag re-run REUSES it; `--gen-password` rotates it.
# Security is always ON (built-in `elastic` superuser, HTTP basic auth over plain HTTP).

ES_VERSION=9.4

# Built-in superuser is `elastic`; password auto-generated if empty.
ELASTIC_PASSWORD=

# Network. 0.0.0.0 lets a remote client reach it (auth is required); 127.0.0.1 restricts to loopback.
ES_NETWORK_HOST=0.0.0.0
ES_HTTP_PORT=9200
ES_CLUSTER_NAME=dokandar

# JVM heap (-Xms/-Xmx). Keep small on shared boxes; <= ~50% RAM and <= 31g.
ES_JAVA_HEAP=512m

# Data lives under ${DATA_ROOT}/elasticsearch (symlinked from /var/lib/elasticsearch).
DATA_ROOT=/data

# Elasticsearch 9.4 — Docker Compose HA cluster (3 nodes es01/es02/es03). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this `.env.example` is committed. Keep comments on their OWN lines.
#
# Leave ELASTIC_PASSWORD EMPTY to auto-generate a COMPLEX password (`setup.sh up` fills it + generates the
# shared transport-TLS cert before bootstrapping, shows the password once, saves it here). `--gen-password`
# rotates ONLY the elastic password; the transport cert is generated once and never rotated.

ES_IMAGE_TAG=9.4.2
ES_CLUSTER_NAME=dokandar

# Built-in superuser `elastic`; auto-generated if empty.
ELASTIC_PASSWORD=

# JVM heap PER NODE (-Xms/-Xmx). 3 nodes on one box — keep small.
ES_JAVA_HEAP=512m

# Host ports for the three nodes (each container listens on 9200). Change if taken.
ES_PORT1=9200
ES_PORT2=9201
ES_PORT3=9202

# Host path of the shared transport-TLS keystore (PKCS12). Auto-generated by setup.sh.
CERTS_HOST_PATH=/data/es_cluster/certs

# Per-node data under ${DATA_ROOT}/es_cluster/{es01,es02,es03} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

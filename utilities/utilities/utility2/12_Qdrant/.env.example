# Optional config for `test.sh` — copy to `.env` to point the test at ANY Qdrant with these values.
#   cp .env.example .env        # then fill in host + key
# `.env` is gitignored. test.sh uses this only when you DON'T pass a variant folder / set them via env.

# QDRANT_HOST=127.0.0.1
# QDRANT_HTTP_PORT=6333
# QDRANT_API_KEY=your-api-key

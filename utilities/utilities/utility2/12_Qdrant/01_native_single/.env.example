# Qdrant — native single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates QDRANT_API_KEY if it's empty, and saves it back here.

# REST/gRPC API key (header `api-key: <key>`). Leave EMPTY → setup.sh generates a 24-char key.
QDRANT_API_KEY=

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Bind address. 0.0.0.0 exposes the REST/dashboard off-box (SG-fenced + api-key); 127.0.0.1 = loopback only.
QDRANT_HOST=0.0.0.0

# Data under ${DATA_ROOT}/qdrant (symlinked from /var/lib/qdrant).
DATA_ROOT=/data

# Qdrant — Docker HA cluster (3 peers, one Raft consensus group). Copy to `.env`:
#   cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates QDRANT_API_KEY if empty (identical on all 3 peers) and writes it back here.

QDRANT_IMAGE=qdrant/qdrant:v1.18.2

# REST/gRPC API key. Leave EMPTY → setup.sh generates a 24-char key and writes it here.
QDRANT_API_KEY=

# Each peer publishes its REST port on the host (q1 also publishes gRPC).
Q_HTTP1=6333
Q_HTTP2=6343
Q_HTTP3=6353
Q_GRPC1=6334

# Collection HA: each shard replicated to N peers so the cluster survives one node loss.
QDRANT_SHARD_NUMBER=3
QDRANT_REPLICATION_FACTOR=2

# Per-node storage under ${DATA_ROOT}/qdrant_cluster/n{1,2,3} (BIND MOUNTS — survive `down -v`).
DATA_ROOT=/data

# Qdrant — Docker single-node. Copy to `.env`:  cp .env.example .env
# `.env` is gitignored; only this template is committed. Keep comments on their OWN lines.
# setup.sh auto-generates QDRANT_API_KEY if empty, and writes it back here.

QDRANT_IMAGE=qdrant/qdrant:v1.18.2

# REST/gRPC API key. Leave EMPTY → setup.sh generates a 24-char key and writes it here.
QDRANT_API_KEY=

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Host bind mount under ${DATA_ROOT}/qdrant_docker (survives `down -v`).
DATA_ROOT=/data

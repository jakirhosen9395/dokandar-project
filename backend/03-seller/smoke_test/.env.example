# =============================================================================
# smoke_test/.env.example  —  copy to smoke_test/.env and edit, OR export these
# vars before running test.sh. Every value has a sensible default.
#   cp smoke_test/.env.example smoke_test/.env && vim smoke_test/.env
# =============================================================================

# --- target (service under test) --------------------------------------------
# On the app box the shop service is published on host port 10003.
#   on the box:        http://127.0.0.1:10003
#   from a laptop:     http://3.109.183.124:10003
#   via API gateway:   http://3.109.183.124:10015   (rewrites /api/v1/shop/*)
SHOP_URL=http://3.109.183.124:10003

# --- peers needed to TEST shop (taken from env, per the platform rule) -------
# Shop is downstream: writes need a real RS256 token (verified offline against
# auth's public key), AND shop CALLS auth over gRPC (LookupShopkeeper) during
# staff-assign. The harness mints admin/shopkeeper/shop_staff/customer tokens
# from AUTH and reads OTP codes from SUPPORT.
AUTH_URL=http://3.109.183.124:10001
SUPPORT_URL=http://3.109.183.124:10099

# Seeded platform admin (auth DEFAULT_ADMIN_PHONE) — used to provision shopkeepers.
ADMIN_PHONE=01700000000

# --- OTP recovery fallback (only if SUPPORT_URL is unreachable) --------------
AUTH_CONTAINER=dokandar_auth_service_dev
# AUTH_SSH=ubuntu@3.109.183.124
# AUTH_SSH_KEY=/home/jakir/Desktop/DevOps/mumbai-key.pem

# --- admin OTP rate-limit reset (best-effort; reruns reuse the admin phone) --
# REDIS_RESET_URL=redis://:<password>@172.31.33.176:6379/0

# --- harness knobs -----------------------------------------------------------
# per-request curl timeout, seconds (keep comments on their OWN line)
TIMEOUT=15
HEALTH_TIMEOUT=30
# seconds to wait for the KYC-tier mirror (auth approve → Kafka → shop cache)
MIRROR_TIMEOUT=40
# NO_COLOR=1

# =============================================================================
# Cross-service note: shop PRODUCES dokandar.shop.changed (outbox→Kafka) and
# CONSUMES dokandar.kyc.{approved,rejected} (→ shopkeeper_kyc_cache, surfaced as
# kyc_tier on GET /shops/handle/{handle}). It CALLS auth.LookupShopkeeper over
# gRPC for staff-assign (needs the shared INTERNAL_SERVICE_TOKEN). The only
# peers this TEST needs are AUTH (tokens + the gRPC target) and SUPPORT (OTP).
# The fleet-standard NN_* discovery vars are accepted-but-ignored here.
# =============================================================================
# 01_AUTH_HOST=172.31.36.181
# 01_AUTH_PORT=10001
# 03_SHOP_HOST=172.31.36.181
# 03_SHOP_PORT=10003

# .env.example — the runtime env vars 00-support reads (placeholders only).
# DEV/STAGE ONLY. The real values hold secrets → NEVER commit a filled .env.
#
# Recommended: don't fill this by hand — paste the infra creds into env/env.txt
# (### NN_Service format) and run ./env/init-env.sh .env.dev, which renders
# env/.env.dev for you. This file just documents the variables.

APP_ENV=dev
SERVICE_NAME=00-support
SERVICE_PORT=10000

# RabbitMQ — the SAME value the auth service uses (to consume the OTP queue)
RABBITMQ_URL=amqp://<user>:<password>@<host>:5672/
OTP_QUEUE=notifications.otp.send

# auth Postgres DSN — enables email→phone search (optional; point at the auth DB)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/dokandar_auth_dev

# Payment webhook simulator — point at the payment service + its stub secret
PAYMENT_BASE_URL=http://<host>:10009
PAYMENT_STUB_WEBHOOK_SECRET=<dev-stub-secret>

# OTP capture buffer size
BUFFER_SIZE=500

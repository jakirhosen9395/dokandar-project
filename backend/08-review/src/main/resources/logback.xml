<configuration>
  <!-- App logs go through com.dokandar.review.observability.Log (3-sink). This config only
       quiets framework loggers to avoid the ES feedback loop + stdout noise. -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder><pattern>%d{HH:mm:ss} %-5level %logger{0} - %msg%n</pattern></encoder>
  </appender>
  <root level="WARN"><appender-ref ref="STDERR"/></root>
  <logger name="io.netty" level="ERROR"/>
  <logger name="org.apache.kafka" level="WARN"/>
  <logger name="io.ktor" level="WARN"/>
  <logger name="com.zaxxer.hikari" level="WARN"/>
  <logger name="org.mongodb.driver" level="WARN"/>
</configuration>

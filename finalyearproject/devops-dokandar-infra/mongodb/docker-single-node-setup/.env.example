# MongoDB 8 — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# Keep comments on their own lines.

# Image version — pinned EXACTLY. 7.0 line chosen over 8.x for stability
# (8.2 restart-looped on this host); nothing here depends on 8.x features.
MONGO_VERSION=7.0.37

# Root user, created on FIRST start only.
MONGO_ROOT_USER=dki

# LEAVE EMPTY — setup_env.sh generates a strong 24-char password (chmod 600).
MONGO_ROOT_PASSWORD=

# Host port published as 0.0.0.0:<port> -> container 27017 (standard — dedicated server).
MONGO_PORT=27017

# RAM cap for the container (mandatory — host stability).
MONGO_MEM_LIMIT=1g

# This server's IP as printed in connection endpoints (PRIVATE/VPC by default).
# LEAVE EMPTY — setup_env.sh auto-detects the machine PRIVATE IP (EC2 local-ipv4).
SERVER_IP=

# Host directory for db + configdb files (bind mounts — survive `down -v`).
DATA_ROOT=/data/dki

# PostgreSQL 18 — docker-single-node. Copy me:  cp .env.example .env   (or run setup_env.sh)
# .env is gitignored because it will hold a REAL password. Keep comments on their own lines —
# docker compose does NOT strip inline comments after values.

# Image version (Docker Hub `postgres`). The live DOKANDAR platform runs 18.
POSTGRES_VERSION=18.4

# Superuser name and default database (created on first start).
POSTGRES_USER=dki
POSTGRES_DB=dki

# LEAVE EMPTY — setup_env.sh generates a strong 24-char password here (chmod 600).
POSTGRES_PASSWORD=

# Host port published as 0.0.0.0:<port> -> container 5432 (standard — dedicated server).
POSTGRES_PORT=5432

# RAM cap for the container (mandatory — keeps the 8GB host stable).
POSTGRES_MEM_LIMIT=1g

# THE CONSOLIDATION LESSON — one server, MANY databases (comma list).
# Each name gets its own database + same-named role; per-role passwords are
# auto-generated into this file as DKD_PASSWORD_<NAME> by setup.sh. Add a new
# name here and re-run `bash setup.sh up` to provision it — NO new container.
DKD_DATABASES=dkd_identity,dkd_catalog,dkd_custody

# This server's IP as printed in connection endpoints (PRIVATE/VPC by default).
# LEAVE EMPTY — setup_env.sh auto-detects the machine PRIVATE IP (EC2 local-ipv4).
SERVER_IP=

# Host directory holding the database files (bind mount — survives `down -v`).
DATA_ROOT=/data/dki

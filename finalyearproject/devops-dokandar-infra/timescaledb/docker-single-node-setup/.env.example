# TimescaleDB — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# Keep comments on their own lines.

TSDB_VERSION=2.28.2-pg17
TSDB_USER=dki
# LEAVE EMPTY — setup_env.sh generates a strong 24-char password (chmod 600).
TSDB_PASSWORD=
TSDB_DB=dki_metrics

# Host port -> container 5432. 5433 because plain PostgreSQL owns 5432 on this server.
TSDB_PORT=5433

# RAM cap for the container (mandatory — host stability).
TSDB_MEM_LIMIT=1g

DATA_ROOT=/data/dki
SERVER_IP=

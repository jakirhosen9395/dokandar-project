# Neo4j 5.26 Community — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# Keep comments on their own lines. The admin user is always "neo4j".

NEO4J_VERSION=5.26.28-community

# LEAVE EMPTY — setup_env.sh generates a strong 24-char password (chmod 600).
# Neo4j rejects very short passwords; 24 chars is comfortably safe.
NEO4J_PASSWORD=

# Host ports: the Browser UI (HTTP) and Bolt (drivers/cypher-shell) — standard.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# JVM heap / page cache / container RAM cap (mandatory — host stability).
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m
NEO4J_MEM_LIMIT=1200m

# This server's IP as printed in connection endpoints (PRIVATE/VPC by default).
# LEAVE EMPTY — setup_env.sh auto-detects the machine PRIVATE IP (EC2 local-ipv4).
SERVER_IP=

# Host directory for the graph store (bind mount — survives `down -v`).
DATA_ROOT=/data/dki

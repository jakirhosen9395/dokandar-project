# OpenSearch 2.17 — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# Keep comments on their own lines.
# This teaching node runs with the security plugin OFF (no password) — matching the DOKANDAR
# platform's local config. There is deliberately no *_PASSWORD to generate.

OPENSEARCH_VERSION=2.17.1

# Host port published as 0.0.0.0:<port> -> container 9200 (REST API).
# CANONICAL fleet port = 9201 (NOT 9200: elastic-apm-stack Elasticsearch owns 9200,
# so the two never collide even when they share one box).
OPENSEARCH_PORT=9201

# JVM heap + container RAM cap (mandatory — host stability).
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"
OPENSEARCH_MEM_LIMIT=1500m

# This server's IP as printed in connection endpoints (PRIVATE/VPC by default).
# LEAVE EMPTY — setup_env.sh auto-detects the machine PRIVATE IP (EC2 local-ipv4).
SERVER_IP=

# Host directory for the indices (bind mount — survives `down -v`).
DATA_ROOT=/data/dki

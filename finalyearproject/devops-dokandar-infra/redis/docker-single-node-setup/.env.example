# Redis 8 — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# Keep comments on their own lines (compose does not strip inline comments).

# Image version (Docker Hub `redis`). The live platform runs 8.
REDIS_VERSION=8.8.0

# LEAVE EMPTY — setup_env.sh generates a strong 24-char password (chmod 600).
REDIS_PASSWORD=

# Host port published as 0.0.0.0:<port> -> container 6379 (standard — dedicated server).
REDIS_PORT=6379

# RAM cap for the container (mandatory — host stability).
REDIS_MEM_LIMIT=384m

# This server's IP as printed in connection endpoints (PRIVATE/VPC by default).
# LEAVE EMPTY — setup_env.sh auto-detects the machine PRIVATE IP (EC2 local-ipv4).
SERVER_IP=

# Cap Redis memory (it evicts least-recently-used keys past this).
REDIS_MAXMEMORY=256mb

# Host directory for the AOF/RDB files (bind mount — survives `down -v`).
DATA_ROOT=/data/dki

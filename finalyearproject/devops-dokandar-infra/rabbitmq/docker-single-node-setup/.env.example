# RabbitMQ 4 — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# Keep comments on their own lines.

# Image tag (Docker Hub `rabbitmq`); `-management` includes the web UI.
RABBITMQ_IMAGE_TAG=4.3.2-management

# Default user created on first start.
RABBITMQ_USER=dki

# LEAVE EMPTY — setup_env.sh generates a strong 24-char password (chmod 600).
RABBITMQ_PASSWORD=

# Host ports: AMQP (applications) and the Management web UI (browser) — standard.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# RAM cap for the container (mandatory — host stability).
RABBITMQ_MEM_LIMIT=512m

# This server's IP as printed in connection endpoints (PRIVATE/VPC by default).
# LEAVE EMPTY — setup_env.sh auto-detects the machine PRIVATE IP (EC2 local-ipv4).
SERVER_IP=

# Host directory for the node data (bind mount — survives `down -v`).
DATA_ROOT=/data/dki

# ClickHouse 24.8 — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# Keep comments on their own lines.

# Image version. The live platform runs 24.8.
CH_VERSION=24.8.14.39

# Login user (created on first start).
CLICKHOUSE_USER=dki

# LEAVE EMPTY — setup_env.sh generates a strong 24-char password (chmod 600).
CLICKHOUSE_PASSWORD=

# Host ports: HTTP (browser /play console) and native TCP (clickhouse-client).
# Native maps to 9004 because 9000 on this server belongs to RustFS's S3 API.
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9004

# RAM caps (mandatory): container limit + ClickHouse's own budget in bytes.
CLICKHOUSE_MEM_LIMIT=1500m
CLICKHOUSE_MAX_MEMORY=1200000000

# This server's IP as printed in connection endpoints (PRIVATE/VPC by default).
# LEAVE EMPTY — setup_env.sh auto-detects the machine PRIVATE IP (EC2 local-ipv4).
SERVER_IP=

# Host directory for the column data (bind mount — survives `down -v`).
DATA_ROOT=/data/dki

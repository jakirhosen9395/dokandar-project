# Apicurio Schema Registry (in-memory) — docker-single-node.
# Copy me:  cp .env.example .env  (or run setup_env.sh). No password — the -mem
# teaching build has no auth; the SG is the only fence (learning environment).

APICURIO_VERSION=2.6.5.Final

# Host port -> container 8080. 8081 because kafka-ui owns 8080 on this server.
APICURIO_PORT=8081

# JVM heap + container RAM cap (mandatory — host stability).
APICURIO_JAVA_OPTS="-Xms128m -Xmx384m"
APICURIO_MEM_LIMIT=768m

# This server's public IP (printed in the summary).
SERVER_IP=

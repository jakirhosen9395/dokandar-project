# RustFS — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# Keep comments on their own lines.

RUSTFS_VERSION=1.0.0-beta.8

# S3-style credentials. LEAVE THE SECRET EMPTY — setup_env.sh generates it (chmod 600).
RUSTFS_ACCESS_KEY=dki
RUSTFS_SECRET_KEY=

# Host ports: S3 API and the web console (standard MinIO-style pair).
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# RAM cap for the container (mandatory — host stability).
RUSTFS_MEM_LIMIT=512m

# Host directory for objects + logs (bind mounts — survive `down -v`).
DATA_ROOT=/data/dki

# This server's IP as printed in connection endpoints (PRIVATE/VPC by default).
# LEAVE EMPTY — setup_env.sh auto-detects the machine PRIVATE IP (EC2 local-ipv4).
SERVER_IP=

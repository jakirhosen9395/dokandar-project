# ScyllaDB — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# No auth by default (learning utility) — there is no password to generate.

SCYLLA_VERSION=2025.1.14

# CQL port (standard).
SCYLLA_CQL_PORT=9042

# Scylla's own memory cap + the container cap above it (mandatory — host stability).
SCYLLA_MEMORY=350M
SCYLLA_MEM_LIMIT=1500m

DATA_ROOT=/data/dki
SERVER_IP=

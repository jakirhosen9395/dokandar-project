# Apache Kafka 4.3 (KRaft) + kafka-ui — docker-single-node.
# Copy me:  cp .env.example .env  (or run setup.sh up which fills the blanks)
# Keep comments on their own lines.

KAFKA_VERSION=4.3.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2

# The address EXTERNAL clients (your laptop) reconnect on. EMPTY -> setup.sh fills it with
# this host's PUBLIC IP so external producers/consumers can actually reach the broker.
KAFKA_EXTERNAL_HOST=
# KRaft cluster id (22-char). EMPTY -> setup.sh generates one. Do NOT change after first start.
KAFKA_CLUSTER_ID=

# Host ports: the external broker port and the kafka-ui web port (standard).
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8080

# JVM heap + container RAM caps (mandatory — host stability).
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
KAFKA_MEM_LIMIT=1g
KAFKA_UI_MEM_LIMIT=512m

# This server's public IP (advertised to external clients + printed in the summary).
SERVER_IP=

# Host directory for the Kafka log segments (bind mount — survives `down -v`).
DATA_ROOT=/data/dki

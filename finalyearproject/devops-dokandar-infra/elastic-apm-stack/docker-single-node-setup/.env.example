# Elastic APM stack — docker-single-node. Copy me:  cp .env.example .env  (or run setup_env.sh)
# Keep comments on their own lines. setup_env.sh fills every empty secret below.

# One version for all three images (elasticsearch / kibana / apm-server).
ELASTIC_VERSION=9.2.0

# LEAVE EMPTY — setup_env.sh generates all four secrets (chmod 600):
#   ELASTIC_PASSWORD      login for the `elastic` superuser (Kibana login too)
#   KIBANA_PASSWORD       password setup.sh assigns to the built-in kibana_system user
#   KIBANA_ENCRYPTION_KEY exactly 32 characters (Kibana saved-objects encryption)
#   APM_SECRET_TOKEN      what your app agents present to the APM server
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
KIBANA_ENCRYPTION_KEY=
APM_SECRET_TOKEN=

# Host ports (standard): ES REST, Kibana UI, APM intake.
ES_PORT=9200
KIBANA_PORT=5601
APM_PORT=8200

# JVM heap + per-container RAM caps (mandatory — 8GB host stability).
ES_JAVA_OPTS="-Xms512m -Xmx512m"
ES_MEM_LIMIT=1500m
KIBANA_MEM_LIMIT=1g
APM_MEM_LIMIT=300m

# Host directory for the indices (bind mount — survives `down -v`).
DATA_ROOT=/data/dki

# This server's IP as printed in connection endpoints (PRIVATE/VPC by default).
# LEAVE EMPTY — setup_env.sh auto-detects the machine PRIVATE IP (EC2 local-ipv4).
SERVER_IP=

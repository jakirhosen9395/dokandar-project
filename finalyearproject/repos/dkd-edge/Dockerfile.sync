# syntax=docker/dockerfile:1
# offline-sync-gateway — DOKANDAR edge #34 (Node 22, dependency-free runtime; stateless aggregate reads).
ARG GIT_SHA=unknown
ARG VERSION=0.0.0-dev
ARG BUILD_TIME=unknown

FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY offline-sync-gateway/package.json offline-sync-gateway/tsconfig.json ./
COPY offline-sync-gateway/src ./src
COPY offline-sync-gateway/test ./test
RUN npm install --no-audit --no-fund && npx tsc -p tsconfig.json

FROM node:22-bookworm-slim
ARG GIT_SHA
ARG VERSION
ARG BUILD_TIME
LABEL org.opencontainers.image.title="offline-sync-gateway" \
      org.opencontainers.image.description="DOKANDAR edge — consumer aggregate views (order+shipment+escrow+notifications)" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.source="https://gitlab.com/final-year-project3354127/dkd-edge"
WORKDIR /app
COPY --from=build /src/dist ./dist
RUN printf '{"version":"%s","gitSha":"%s","buildTime":"%s"}' "$VERSION" "$GIT_SHA" "$BUILD_TIME" > /app/build-info.json
EXPOSE 8080
USER node
CMD ["node","dist/src/index.js"]

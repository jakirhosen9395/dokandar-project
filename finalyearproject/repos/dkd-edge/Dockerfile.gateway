# syntax=docker/dockerfile:1
# api-gateway-svc — DOKANDAR edge #33 (pure stdlib Go; stateless mediation).
ARG GIT_SHA=unknown
ARG VERSION=0.0.0-dev
ARG BUILD_TIME=unknown

FROM golang:1.25 AS build
ARG GIT_SHA
ARG VERSION
ARG BUILD_TIME
WORKDIR /src
COPY gateway .
ENV CGO_ENABLED=0
RUN go build -buildvcs=false -ldflags "-X main.version=$VERSION -X main.gitSha=$GIT_SHA -X main.buildTime=$BUILD_TIME" -o /out/api-gateway-svc .

FROM gcr.io/distroless/static-debian12:nonroot
ARG GIT_SHA
ARG VERSION
ARG BUILD_TIME
LABEL org.opencontainers.image.title="api-gateway-svc" \
      org.opencontainers.image.description="DOKANDAR edge — routing, idempotency-presence, rate limiting, problem+json (no business logic)" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.source="https://gitlab.com/final-year-project3354127/dkd-edge"
COPY --from=build /out/api-gateway-svc /api-gateway-svc
EXPOSE 8080
ENTRYPOINT ["/api-gateway-svc"]

# =============================================================================
# DOKANDAR dev-infra — CONFIGURATION (non-secret).  Copy to `.env`:  cp .env.example .env
# Secrets are NOT here — they live in `.env.secrets` (generated by ./gen-secrets.sh, gitignored).
# This separation maps directly to Kubernetes:  .env -> ConfigMap,  .env.secrets -> Secret.
# =============================================================================

# ---- PostgreSQL (per-context relational store) ----
POSTGRES_VERSION=18
POSTGRES_USER=dokandar
POSTGRES_DB=dokandar
POSTGRES_PORT=5432

# ---- Redis (cache) ----
REDIS_VERSION=8
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# ---- Kafka (R6 event spine, KRaft) + UI ----
KAFKA_VERSION=4.3.0
KAFKA_CLUSTER_ID=DokandarDevKafkaClusterXY
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
KAFKA_UI_PORT=8081

# ---- Schema Registry (Apicurio; DOKANDAR R6 extension) ----
APICURIO_VERSION=2.6.5.Final
SCHEMA_REGISTRY_PORT=8082

# ---- RabbitMQ (intra-context queues) ----
RABBITMQ_IMAGE_TAG=4-management
RABBITMQ_DEFAULT_USER=dokandar
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- OpenSearch (DOKANDAR search standard; NOT Elasticsearch) ----
OPENSEARCH_VERSION=2.17.1
OPENSEARCH_CLUSTER_NAME=dokandar
OPENSEARCH_HEAP=512m
OPENSEARCH_HTTP_PORT=9200

# ---- RustFS (S3-compatible object storage; replaces MinIO) ----
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.8
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ---- Observability: Elastic APM stack (ES is an OBSERVABILITY dependency only) ----
APM_STACK_VERSION=9.2.0
APM_ES_HEAP=512m
APM_SERVER_PORT=8200
KIBANA_PORT=5601

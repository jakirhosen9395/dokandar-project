# Local/dev configuration (synthetic only). See config loader for the full set.
DKD_SERVICE_NAME=custody-ledger-svc
DKD_CONTEXT=custody
DKD_HTTP_PORT=8080
DKD_LOG_LEVEL=info
DKD_ENV=local
DKD_KAFKA_BROKERS=localhost:9092
DKD_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
DKD_DB_DSN=postgres://dkd:dkd@localhost:5432/custodyledgersvc?sslmode=disable
DKD_OTEL_ENDPOINT=localhost:4317
DKD_JWT_ISSUER=https://identity.dokandar.local
# Signer-key trust anchor (C3-F2c; FR-PASS-070 root of trust). base64-std Ed25519 PUBLIC key of the
# CA that authorizes key->DID bindings on POST /v1/custody/signer-keys. The CA PRIVATE key is NEVER
# held here. Empty => registration FAILS CLOSED (rejects all bindings). Placeholder only:
DKD_CUSTODY_TRUST_ANCHOR_PUBKEY=
# Attestation authority (C3-F2e; FR-PASS-014/FR-PASS-070). base64-std Ed25519 PUBLIC key of the
# trusted authority that authorizes single-signature, reference-linked custody moves (e.g. a
# logistics POD). The authority PRIVATE key is NEVER held here (it lives in logistics). Empty =>
# attestation mode is UNAVAILABLE (fail closed; human dual-signature still required). Placeholder only:
DKD_CUSTODY_ATTESTATION_AUTHORITY_PUBKEY=

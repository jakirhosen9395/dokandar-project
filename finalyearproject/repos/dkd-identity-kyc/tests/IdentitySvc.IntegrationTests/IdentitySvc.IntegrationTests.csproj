<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"           Version="17.12.0" />
    <PackageReference Include="xunit"                            Version="2.9.0"   />
    <PackageReference Include="xunit.runner.visualstudio"        Version="2.8.2"   />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0"   />
    <!-- Dkd.Platform provided transitively via the IdentitySvc ProjectReference (vendored SDK).
         Integration tests run against a real PostgreSQL provided by the CI `postgres` service
         (DKD_TEST_DB_DSN); no Testcontainers/Docker-in-Docker required. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../IdentitySvc.csproj" />
  </ItemGroup>

</Project>

# catalog-svc — Context #2 Product Master Data & Catalog (R7 master-data OHS). Synthetic data only (ADR-024).
# PLACEHOLDER hostnames only — real endpoints are injected at deploy time via env (standing rule).
DKD_SERVICE_NAME=catalog-svc
DKD_CONTEXT=catalog
DKD_ENV=local
DKD_HTTP_PORT=8080
DKD_METRICS_PORT=9090
DKD_LOG_LEVEL=info

# Kafka spine (cross-context Published Language, R6). Catalog PRODUCES catalog.product.* via outbox.
DKD_KAFKA_BROKERS=<kafka-host>:9092
DKD_CONSUMER_GROUP=catalog-svc

# Postgres — one context, one DB (R6).
DKD_DB_DSN=
DKD_DB_HOST=<postgres-host>
DKD_DB_PORT=5432
DKD_DB_NAME=dkd_catalog
DKD_DB_USER=<db-user>
DKD_DB_PASSWORD=
DKD_DB_SSLMODE=disable

# Business search — OpenSearch ONLY (never observability ES).
DKD_SEARCH_URL=http://<opensearch-host>:9200

DKD_JWT_ISSUER=
DKD_OTEL_ENDPOINT=

# Local/dev configuration (synthetic only). See config loader for the full set.
DKD_SERVICE_NAME=logistics-svc
DKD_CONTEXT=logistics
DKD_HTTP_PORT=8080
DKD_LOG_LEVEL=info
DKD_ENV=local
DKD_KAFKA_BROKERS=localhost:9092
DKD_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
DKD_DB_DSN=postgres://dkd:dkd@localhost:5432/logisticssvc?sslmode=disable
DKD_OTEL_ENDPOINT=localhost:4317
DKD_JWT_ISSUER=https://identity.dokandar.local
DKD_B2C_URL=http://localhost:8102
DKD_CUSTODY_URL=http://localhost:8092
# POD attestation signer (C3-F2e; FR-PASS-014/FR-PASS-070). base64-std Ed25519 PRIVATE key (32-byte
# seed or 64-byte key) used to sign the POD-ATTEST message so custody authorizes the reference-linked
# move via its configured attestation-authority PUBLIC key. ENV ONLY — never printed or committed.
# Empty => POD posts no attestationSignature (C3-F2e path disabled). Placeholder only:
DKD_LOGISTICS_ATTESTATION_PRIVKEY=

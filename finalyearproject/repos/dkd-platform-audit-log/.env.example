# audit-log-svc — Context #13 Platform (append-only OHS audit sink, R6). Synthetic data only (ADR-024).
DKD_SERVICE_NAME=audit-log-svc
DKD_CONTEXT=platform
DKD_ENV=local
DKD_HTTP_PORT=8080
DKD_METRICS_PORT=9090
DKD_LOG_LEVEL=info

# Kafka spine (cross-context Published Language). Consumes every topic; NEVER produces.
DKD_KAFKA_BROKERS=<kafka-host>:9092
DKD_CONSUMER_GROUP=audit-log-svc
# Optional extra topics appended to the canonical AllTopics() set (isolated verification/backfill only).
DKD_EXTRA_TOPICS=

# Append-only WORM store (dkd_platform Postgres). Provide a full DSN or the discrete DKD_DB_* parts.
DKD_DB_DSN=
DKD_DB_HOST=<postgres-host>
DKD_DB_PORT=5432
DKD_DB_NAME=dkd_platform
DKD_DB_USER=dkd
DKD_DB_PASSWORD=
DKD_DB_SSLMODE=disable

DKD_JWT_ISSUER=
DKD_OTEL_ENDPOINT=

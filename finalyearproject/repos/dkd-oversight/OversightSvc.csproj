<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OversightSvc</RootNamespace>
    <AssemblyName>oversight-svc</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="sdk/Dkd.Platform/Dkd.Platform.csproj" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Confluent.Kafka" Version="2.6.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**;sdk/**" />
    <Content Remove="tests/**;sdk/**" />
    <None Remove="tests/**;sdk/**" />
  </ItemGroup>
</Project>

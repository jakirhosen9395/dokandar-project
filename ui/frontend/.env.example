# DOKANDAR frontend — environment template.
# Copy to .env.local on 13.204.65.180 and fill. .env.local is gitignored (never commit secrets).
# Convention: NON-prefixed vars are SERVER-ONLY (never reach the browser). NEXT_PUBLIC_* are client-safe.

# ── Server-only (BFF + DEVOPS proxy + codegen) ───────────────────────────────
# The API Gateway is the ONLY backend the BFF calls. Never exposed to the browser.
GATEWAY_URL=http://172.31.14.241:10015
# App host serving per-service ports — used ONLY at build time (pnpm gen:api) and the DEVOPS proxy.
SPEC_HOST=172.31.14.241
# DEVOPS server-side proxy map (svc -> host:port), JSON. Optional; used by /devops ops-endpoint proxy.
# SERVICE_HOSTS={"01-auth":"172.31.14.241:10001","05-search":"172.31.14.241:10005"}
# Session-cookie ENCRYPTION key — Phase 2 active. SHA-256'd to a 32-byte AES-256-GCM key that encrypts
# the httpOnly session cookie (holds the opaque refresh token + role). Set a long random value in prod.
SESSION_COOKIE_SECRET=
APP_ENV=dev

# ── Client-safe (NEXT_PUBLIC_*) ──────────────────────────────────────────────
# Elastic RUM (browser → APM). Leave RUM_SERVER_URL empty to disable RUM (no-op).
NEXT_PUBLIC_RUM_SERVER_URL=
NEXT_PUBLIC_RUM_SERVICE_NAME=dokandar-web
NEXT_PUBLIC_ENV=dev
NEXT_PUBLIC_DEFAULT_LOCALE=en

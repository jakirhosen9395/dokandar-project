# Non-sensitive runtime config for dokandar-api-gateway -> ConfigMap `dokandar-api-gateway-config` in namespace `gateway`
APP_ENV=prod
TENANT=cloud
LOG_LEVEL=info
SERVICE_NAME=15-api-gateway
# East-west routing via cluster DNS.
# TODO: align variable names with 15-api-gateway's env template.
SUPPORT_SERVICE_URL=http://dokandar-support.support.svc.cluster.local:8000
AUTH_SERVICE_URL=http://dokandar-auth.backend.svc.cluster.local:8000
PROFILE_SERVICE_URL=http://dokandar-profile.backend.svc.cluster.local:8000
SELLER_SERVICE_URL=http://dokandar-seller.backend.svc.cluster.local:8000
CATALOG_SERVICE_URL=http://dokandar-catalog.backend.svc.cluster.local:8000
SEARCH_SERVICE_URL=http://dokandar-search.backend.svc.cluster.local:8000
CART_SERVICE_URL=http://dokandar-cart.backend.svc.cluster.local:8000
COUPON_SERVICE_URL=http://dokandar-coupon.backend.svc.cluster.local:8000
REVIEW_SERVICE_URL=http://dokandar-review.backend.svc.cluster.local:8000
PAYMENT_SERVICE_URL=http://dokandar-payment.backend.svc.cluster.local:8000
WALLET_SERVICE_URL=http://dokandar-wallet.backend.svc.cluster.local:8000
REPORTING_SERVICE_URL=http://dokandar-reporting.backend.svc.cluster.local:8000
MEDIA_SERVICE_URL=http://dokandar-media.backend.svc.cluster.local:8000
ORDER_SERVICE_URL=http://dokandar-order.backend.svc.cluster.local:8000
NOTIFICATION_SERVICE_URL=http://dokandar-notification.backend.svc.cluster.local:8000
RECOMMENDATION_SERVICE_URL=http://dokandar-recommendation.backend.svc.cluster.local:8000
SHIPPING_SERVICE_URL=http://dokandar-shipping.backend.svc.cluster.local:8000
RISK_TRUST_SERVICE_URL=http://dokandar-risk-trust.backend.svc.cluster.local:8000

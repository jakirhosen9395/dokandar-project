# Non-sensitive runtime config for dokandar-frontend -> ConfigMap `dokandar-frontend-config` in namespace `frontend`
APP_ENV=prod
TENANT=cloud
LOG_LEVEL=info
# Server-only, read at runtime (ui/frontend/lib/env.ts)
GATEWAY_URL=http://dokandar-api-gateway.gateway.svc.cluster.local:8000
# NEXT_PUBLIC_* are baked at build time; runtime copies informational only
NEXT_PUBLIC_ENV=prod
NEXT_PUBLIC_DEFAULT_LOCALE=en
